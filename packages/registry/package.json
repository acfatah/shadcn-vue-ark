{
  "name": "packages.registry",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Component registry for shadcn-vue-ark.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "main": "src/index.ts",
  "scripts": {
    "registry": "bun src/cli/index.ts",
    "registry:build": "bun registry build",
    "storybook": "bunx --bun storybook dev --port 6066",
    "storybook:build": "bunx --bun storybook build",
    "storybook:clear-cache": "rm -rf node_modules/.cache/storybook",
    "lint": "bunx --bun eslint",
    "lint:changed": "{ git diff --name-only -z --diff-filter=d --relative HEAD; git ls-files -z --others --exclude-standard -- ':./'; } | xargs -0 -r bunx --bun eslint --pass-on-no-patterns --no-warn-ignored",
    "lint:staged": "bunx --bun eslint --pass-on-no-patterns --no-warn-ignored $(git diff --relative --cached --name-only --diff-filter=d)",
    "lint:inspect": "bunx --bun eslint --inspect-config",
    "format": "bunx --bun eslint --fix",
    "format:changed": "{ git diff --name-only -z --diff-filter=d --relative HEAD; git ls-files -z --others --exclude-standard -- ':./'; } | xargs -0 -r bunx --bun eslint --fix --no-warn-ignored",
    "format:staged": "staged_files=$(git diff --relative --cached --name-only --diff-filter=d); bunx --bun eslint --fix --pass-on-no-patterns --no-warn-ignored $staged_files && git add $staged_files",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "typecheck:stories": "bunx vue-tsc --noEmit -p tsconfig.stories.json",
    "test": "vitest --run --project=unit",
    "test:watch": "vitest --project=unit",
    "check:argtypes": "vitest --run --project=unit stories/__checks__",
    "test:stories": "vitest --run --project=storybook",
    "test:stories:watch": "vitest --project=storybook"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.37.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "@zag-js/core": "^1.42.0",
    "@zag-js/vue": "^1.42.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^1.0.0",
    "nprogress": "^0.2.0",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.40",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@acfatah/eslint-preset": "^5.0.0",
    "@happy-dom/global-registrator": "^20.11.0",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/vue3-vite": "^10.5.2",
    "@tabler/icons-vue": "^3.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/common-tags": "^1.8.4",
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/integrations": "^14.3.0",
    "@vueuse/router": "^14.3.0",
    "bun-types": "^1.3.14",
    "commander": "^15.0.0",
    "common-tags": "^1.8.2",
    "consola": "^3.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-storybook": "^10.5.2",
    "jiti": "^2.7.0",
    "lodash": "^4.18.1",
    "oxc-parser": "^0.140.0",
    "pathe": "^2.0.3",
    "pinia": "^4.0.2",
    "playwright": "^1.61.1",
    "storybook": "^10.5.2",
    "storybook-vue3-router": "^7.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.10",
    "vue-component-meta": "^3.3.7",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.7",
    "zod": "^4.4.3"
  }
}
