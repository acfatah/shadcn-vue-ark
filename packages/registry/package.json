{
  "name": "packages.registry",
  "type": "module",
  "version": "0.0.0",
  "description": "Component registry for shadcn-vue-ark.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "main": "src/index.ts",
  "scripts": {
    "registry": "bun src/cli/index.ts",
    "registry:build": "bun registry build",
    "lint": "bunx --bun eslint",
    "lint:changed": "{ git diff --name-only -z --diff-filter=d --relative HEAD; git ls-files -z --others --exclude-standard -- ':./'; } | xargs -0 -r bunx --bun eslint --pass-on-no-patterns --no-warn-ignored",
    "lint:staged": "bunx --bun eslint --pass-on-no-patterns --no-warn-ignored $(git diff --relative --cached --name-only --diff-filter=d)",
    "lint:inspect": "bunx --bun eslint --inspect-config",
    "format": "bunx --bun eslint --fix",
    "format:changed": "{ git diff --name-only -z --diff-filter=d --relative HEAD; git ls-files -z --others --exclude-standard -- ':./'; } | xargs -0 -r bunx --bun eslint --fix --no-warn-ignored",
    "format:staged": "staged_files=$(git diff --relative --cached --name-only --diff-filter=d); bunx --bun eslint --fix --pass-on-no-patterns --no-warn-ignored $staged_files && git add $staged_files",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.37.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "@zag-js/core": "^1.41.1",
    "@zag-js/vue": "^1.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.563.0",
    "nprogress": "^0.2.0",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.35",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@acfatah/eslint-preset": "^3.2.0",
    "@happy-dom/global-registrator": "^20.10.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/common-tags": "^1.8.4",
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.8.1",
    "bun-types": "^1.3.14",
    "commander": "^14.0.3",
    "common-tags": "^1.8.2",
    "consola": "^3.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "lodash": "^4.18.1",
    "oxc-parser": "^0.110.0",
    "pathe": "^2.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
