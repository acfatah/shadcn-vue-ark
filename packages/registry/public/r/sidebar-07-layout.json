{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-07-layout",
  "title": "Sidebar 07",
  "description": "A sidebar layout that collapses to icons with team switcher,\ncollapsible navigation, projects list, and user menu.\n\nReferences:\n- shadcn/ui: https://ui.shadcn.com/docs/components/sidebar\n- Ark UI: https://ark-ui.com",
  "dependencies": [
    "lucide-vue-next"
  ],
  "registryDependencies": [
    "https://raw.githubusercontent.com/acfatah/shadcn-vue-ark/refs/heads/main/packages/registry/public/r/sidebar.json",
    "https://raw.githubusercontent.com/acfatah/shadcn-vue-ark/refs/heads/main/packages/registry/public/r/separator.json",
    "https://raw.githubusercontent.com/acfatah/shadcn-vue-ark/refs/heads/main/packages/registry/public/r/collapsible.json",
    "https://raw.githubusercontent.com/acfatah/shadcn-vue-ark/refs/heads/main/packages/registry/public/r/dropdown-menu.json",
    "https://raw.githubusercontent.com/acfatah/shadcn-vue-ark/refs/heads/main/packages/registry/public/r/avatar.json"
  ],
  "files": [
    {
      "path": "src/layouts/sidebar-07/SidebarLayout.vue",
      "content": "<script setup lang=\"ts\">\nimport { Sidebar } from '@/components/ui/sidebar'\n\nimport LayoutHeader from './LayoutHeader.vue'\nimport SidebarLeft from './SidebarLeft.vue'\n</script>\n\n<template>\n  <Sidebar.Provider>\n    <SidebarLeft />\n    <Sidebar.Inset>\n      <LayoutHeader />\n      <RouterView />\n    </Sidebar.Inset>\n  </Sidebar.Provider>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/SidebarLayout.vue"
    },
    {
      "path": "src/layouts/sidebar-07/SidebarLeft.vue",
      "content": "<script setup lang=\"ts\">\nimport { Sidebar } from '@/components/ui/sidebar'\n\nimport { data } from './data'\nimport NavMain from './NavMain.vue'\nimport NavProjects from './NavProjects.vue'\nimport NavUser from './NavUser.vue'\nimport TeamSwitcher from './TeamSwitcher.vue'\n</script>\n\n<template>\n  <Sidebar.Root collapsible=\"icon\">\n    <Sidebar.Header>\n      <TeamSwitcher :teams=\"data.teams\" />\n    </Sidebar.Header>\n    <Sidebar.Content>\n      <NavMain :items=\"data.navMain\" />\n      <NavProjects :projects=\"data.projects\" />\n    </Sidebar.Content>\n    <Sidebar.Footer>\n      <NavUser :user=\"data.user\" />\n    </Sidebar.Footer>\n    <Sidebar.Rail />\n  </Sidebar.Root>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/SidebarLeft.vue"
    },
    {
      "path": "src/layouts/sidebar-07/LayoutHeader.vue",
      "content": "<script setup lang=\"ts\">\nimport { Separator } from '@/components/ui/separator'\nimport { Sidebar } from '@/components/ui/sidebar'\n</script>\n\n<template>\n  <header\n    class=\"\n      flex h-16 shrink-0 items-center gap-2 border-b px-4 transition-[width,height] ease-linear\n      group-has-data-[collapsible=icon]/sidebar-wrapper:h-12\n    \"\n  >\n    <div class=\"flex items-center gap-2\">\n      <Sidebar.Trigger class=\"-ml-1\" />\n      <Separator orientation=\"vertical\" class=\"mr-2 h-4!\" />\n    </div>\n  </header>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/LayoutHeader.vue"
    },
    {
      "path": "src/layouts/sidebar-07/NavMain.vue",
      "content": "<script setup lang=\"ts\">\nimport type { VNode } from 'vue'\n\nimport { ChevronRightIcon } from 'lucide-vue-next'\n\nimport { Collapsible } from '@/components/ui/collapsible'\nimport { Sidebar } from '@/components/ui/sidebar'\n\ndefineProps<{\n  items: {\n    title: string\n    url: string\n    icon?: VNode\n    isActive?: boolean\n    items?: {\n      title: string\n      url: string\n    }[]\n  }[]\n}>()\n</script>\n\n<template>\n  <Sidebar.Group>\n    <Sidebar.GroupLabel>Platform</Sidebar.GroupLabel>\n    <Sidebar.Menu>\n      <Collapsible.Root\n        v-for=\"item in items\"\n        :key=\"item.title\"\n        as-child\n        :default-open=\"item.isActive\"\n        class=\"group/collapsible\"\n      >\n        <Sidebar.MenuItem>\n          <Collapsible.Trigger as-child>\n            <Sidebar.MenuButton :tooltip=\"item.title\" class=\"hover:cursor-pointer\">\n              <component :is=\"item.icon\" />\n              <span>{{ item.title }}</span>\n              <ChevronRightIcon\n                class=\"\n                  ml-auto transition-transform duration-200\n                  group-data-[state=open]/collapsible:rotate-90\n                \"\n              />\n            </Sidebar.MenuButton>\n          </Collapsible.Trigger>\n          <Collapsible.Content>\n            <Sidebar.MenuSub>\n              <Sidebar.MenuSubItem\n                v-for=\"subItem in item.items\"\n                :key=\"subItem.title\"\n              >\n                <Sidebar.MenuSubButton as-child>\n                  <a :href=\"subItem.url\">\n                    <span>{{ subItem.title }}</span>\n                  </a>\n                </Sidebar.MenuSubButton>\n              </Sidebar.MenuSubItem>\n            </Sidebar.MenuSub>\n          </Collapsible.Content>\n        </Sidebar.MenuItem>\n      </Collapsible.Root>\n    </Sidebar.Menu>\n  </Sidebar.Group>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/NavMain.vue"
    },
    {
      "path": "src/layouts/sidebar-07/NavProjects.vue",
      "content": "<script setup lang=\"ts\">\nimport type { VNode } from 'vue'\n\nimport {\n  EllipsisIcon,\n  FolderIcon,\n  ForwardIcon,\n  Trash2Icon,\n} from 'lucide-vue-next'\n\nimport { DropdownMenu } from '@/components/ui/dropdown-menu'\nimport { Sidebar } from '@/components/ui/sidebar'\n\ndefineProps<{\n  projects: {\n    name: string\n    url: string\n    icon: VNode\n  }[]\n}>()\n</script>\n\n<template>\n  <Sidebar.Group class=\"group-data-[collapsible=icon]:hidden\">\n    <Sidebar.GroupLabel>Projects</Sidebar.GroupLabel>\n    <Sidebar.Menu>\n      <Sidebar.MenuItem\n        v-for=\"item in projects\"\n        :key=\"item.name\"\n      >\n        <Sidebar.MenuButton as-child>\n          <a :href=\"item.url\">\n            <component :is=\"item.icon\" />\n            <span>{{ item.name }}</span>\n          </a>\n        </Sidebar.MenuButton>\n        <DropdownMenu.Root side=\"bottom\" align=\"start\" :positioning=\"{ strategy: 'fixed' }\">\n          <DropdownMenu.Trigger as-child>\n            <Sidebar.MenuAction show-on-hover class=\"hover:cursor-pointer\">\n              <EllipsisIcon />\n              <span class=\"sr-only\">More</span>\n            </Sidebar.MenuAction>\n          </DropdownMenu.Trigger>\n          <DropdownMenu.Content class=\"w-48 rounded-lg\">\n            <DropdownMenu.Item value=\"view-project\">\n              <FolderIcon class=\"text-muted-foreground\" />\n              <span>View Project</span>\n            </DropdownMenu.Item>\n            <DropdownMenu.Item value=\"share-project\">\n              <ForwardIcon class=\"text-muted-foreground\" />\n              <span>Share Project</span>\n            </DropdownMenu.Item>\n            <DropdownMenu.Separator />\n            <DropdownMenu.Item value=\"delete-project\">\n              <Trash2Icon class=\"text-muted-foreground\" />\n              <span>Delete Project</span>\n            </DropdownMenu.Item>\n          </DropdownMenu.Content>\n        </DropdownMenu.Root>\n      </Sidebar.MenuItem>\n      <Sidebar.MenuItem>\n        <Sidebar.MenuButton class=\"text-sidebar-foreground/70\">\n          <EllipsisIcon class=\"text-sidebar-foreground/70\" />\n          <span>More</span>\n        </Sidebar.MenuButton>\n      </Sidebar.MenuItem>\n    </Sidebar.Menu>\n  </Sidebar.Group>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/NavProjects.vue"
    },
    {
      "path": "src/layouts/sidebar-07/NavUser.vue",
      "content": "<script setup lang=\"ts\">\nimport {\n  BadgeCheckIcon,\n  BellIcon,\n  ChevronsUpDownIcon,\n  CreditCardIcon,\n  LogOutIcon,\n  SparklesIcon,\n} from 'lucide-vue-next'\n\nimport { Avatar } from '@/components/ui/avatar'\nimport { DropdownMenu } from '@/components/ui/dropdown-menu'\nimport { Sidebar } from '@/components/ui/sidebar'\n\ndefineProps<{\n  user: {\n    name: string\n    email: string\n    avatar: string\n  }\n}>()\n</script>\n\n<template>\n  <Sidebar.Menu>\n    <Sidebar.MenuItem>\n      <DropdownMenu.Root side=\"bottom\" align=\"end\" :side-offset=\"4\" :positioning=\"{ strategy: 'fixed' }\">\n        <DropdownMenu.Trigger as-child class=\"hover:cursor-pointer\">\n          <Sidebar.MenuButton\n            size=\"lg\"\n            class=\"\n              data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground\n            \"\n          >\n            <Avatar.Root class=\"size-8 rounded-lg\">\n              <Avatar.Image :src=\"user.avatar\" :alt=\"user.name\" />\n              <Avatar.Fallback class=\"rounded-lg\">\n                CN\n              </Avatar.Fallback>\n            </Avatar.Root>\n            <div class=\"grid flex-1 text-left text-sm/tight\">\n              <span class=\"truncate font-semibold\">{{ user.name }}</span>\n              <span class=\"truncate text-xs\">{{ user.email }}</span>\n            </div>\n            <ChevronsUpDownIcon class=\"ml-auto\" />\n          </Sidebar.MenuButton>\n        </DropdownMenu.Trigger>\n        <DropdownMenu.Content\n          class=\"min-w-56 rounded-lg\"\n        >\n          <DropdownMenu.Group>\n            <DropdownMenu.Label class=\"p-0 font-normal\">\n              <div class=\"flex items-center gap-2 px-1 py-1.5 text-left text-sm\">\n                <Avatar.Root class=\"size-8 rounded-lg\">\n                  <Avatar.Image :src=\"user.avatar\" :alt=\"user.name\" />\n                  <Avatar.Fallback class=\"rounded-lg\">\n                    CN\n                  </Avatar.Fallback>\n                </Avatar.Root>\n                <div class=\"grid flex-1 text-left text-sm/tight\">\n                  <span class=\"truncate font-semibold\">{{ user.name }}</span>\n                  <span class=\"truncate text-xs\">{{ user.email }}</span>\n                </div>\n              </div>\n            </DropdownMenu.Label>\n          </DropdownMenu.Group>\n          <DropdownMenu.Separator />\n          <DropdownMenu.Group>\n            <DropdownMenu.Item value=\"upgrade\">\n              <SparklesIcon />\n              Upgrade to Pro\n            </DropdownMenu.Item>\n          </DropdownMenu.Group>\n          <DropdownMenu.Separator />\n          <DropdownMenu.Group>\n            <DropdownMenu.Item value=\"account\">\n              <BadgeCheckIcon />\n              Account\n            </DropdownMenu.Item>\n            <DropdownMenu.Item value=\"billing\">\n              <CreditCardIcon />\n              Billing\n            </DropdownMenu.Item>\n            <DropdownMenu.Item value=\"notifications\">\n              <BellIcon />\n              Notifications\n            </DropdownMenu.Item>\n          </DropdownMenu.Group>\n          <DropdownMenu.Separator />\n          <DropdownMenu.Item value=\"logout\">\n            <LogOutIcon />\n            Log out\n          </DropdownMenu.Item>\n        </DropdownMenu.Content>\n      </DropdownMenu.Root>\n    </Sidebar.MenuItem>\n  </Sidebar.Menu>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/NavUser.vue"
    },
    {
      "path": "src/layouts/sidebar-07/TeamSwitcher.vue",
      "content": "<script setup lang=\"ts\">\nimport type { VNode } from 'vue'\n\nimport { ChevronsUpDownIcon, PlusIcon } from 'lucide-vue-next'\nimport { ref } from 'vue'\n\nimport { DropdownMenu } from '@/components/ui/dropdown-menu'\nimport { Sidebar } from '@/components/ui/sidebar'\n\ninterface Team {\n  name: string\n  logo: VNode\n  plan: string\n}\n\nconst { teams } = defineProps<{\n  teams: Team[]\n}>()\n\nconst activeTeam = ref(teams[0]!)\n\nfunction setActiveTeam(team: Team) {\n  activeTeam.value = team\n}\n</script>\n\n<template>\n  <Sidebar.Menu>\n    <Sidebar.MenuItem>\n      <DropdownMenu.Root align=\"start\" side=\"bottom\" :side-offset=\"4\" :positioning=\"{ strategy: 'fixed' }\">\n        <DropdownMenu.Trigger class=\"hover:cursor-pointer\" as-child>\n          <Sidebar.MenuButton\n            size=\"lg\"\n            class=\"\n              data-[state=open]:bg-sidebar-accent data-[state=open]:text-sidebar-accent-foreground\n            \"\n          >\n            <div\n              class=\"\n                flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary\n                text-sidebar-primary-foreground\n              \"\n            >\n              <component :is=\"activeTeam.logo\" class=\"size-4\" />\n            </div>\n            <div class=\"grid flex-1 text-left text-sm/tight\">\n              <span class=\"truncate font-semibold\">{{ activeTeam.name }}</span>\n              <span class=\"truncate text-xs\">{{ activeTeam.plan }}</span>\n            </div>\n            <ChevronsUpDownIcon class=\"ml-auto\" />\n          </Sidebar.MenuButton>\n        </DropdownMenu.Trigger>\n        <DropdownMenu.Content\n          class=\"min-w-56 rounded-lg\"\n        >\n          <DropdownMenu.Group>\n            <DropdownMenu.Label class=\"text-xs text-muted-foreground\">\n              Teams\n            </DropdownMenu.Label>\n            <DropdownMenu.Item\n              v-for=\"(team, index) in teams\"\n              :key=\"team.name\"\n              :value=\"team.name\"\n              class=\"gap-2 p-2\"\n              @click=\"setActiveTeam(team)\"\n            >\n              <div class=\"flex size-6 items-center justify-center rounded-sm border\">\n                <component :is=\"team.logo\" class=\"size-4 shrink-0\" />\n              </div>\n              {{ team.name }}\n              <DropdownMenu.Shortcut>{{ index + 1 }}</DropdownMenu.Shortcut>\n            </DropdownMenu.Item>\n          </DropdownMenu.Group>\n          <DropdownMenu.Separator />\n          <DropdownMenu.Item value=\"add-team\" class=\"gap-2 p-2\">\n            <div\n              class=\"flex size-6 items-center justify-center rounded-md border bg-background\"\n            >\n              <PlusIcon class=\"size-4\" />\n            </div>\n            <div class=\"font-medium text-muted-foreground\">\n              Add team\n            </div>\n          </DropdownMenu.Item>\n        </DropdownMenu.Content>\n      </DropdownMenu.Root>\n    </Sidebar.MenuItem>\n  </Sidebar.Menu>\n</template>\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/TeamSwitcher.vue"
    },
    {
      "path": "src/layouts/sidebar-07/data.ts",
      "content": "import {\n  AudioWaveformIcon,\n  BookOpenIcon,\n  BotIcon,\n  CommandIcon,\n  FrameIcon,\n  GalleryVerticalEndIcon,\n  MapIcon,\n  PieChartIcon,\n  Settings2Icon,\n  SquareTerminalIcon,\n} from 'lucide-vue-next'\nimport { h } from 'vue'\n\nexport const data = {\n  user: {\n    name: 'shadcn',\n    email: 'm@example.com',\n    avatar: 'https://github.com/shadcn.png',\n  },\n\n  teams: [\n    {\n      name: 'Acme Inc',\n      logo: h(GalleryVerticalEndIcon),\n      plan: 'Enterprise',\n    },\n    {\n      name: 'Acme Corp.',\n      logo: h(AudioWaveformIcon),\n      plan: 'Startup',\n    },\n    {\n      name: 'Evil Corp.',\n      logo: h(CommandIcon),\n      plan: 'Free',\n    },\n  ],\n\n  navMain: [\n    {\n      title: 'Playground',\n      url: '#',\n      icon: h(SquareTerminalIcon),\n      isActive: true,\n      items: [\n        { title: 'History', url: '#' },\n        { title: 'Starred', url: '#' },\n        { title: 'Settings', url: '#' },\n      ],\n    },\n    {\n      title: 'Models',\n      url: '#',\n      icon: h(BotIcon),\n      items: [\n        { title: 'Genesis', url: '#' },\n        { title: 'Explorer', url: '#' },\n        { title: 'Quantum', url: '#' },\n      ],\n    },\n    {\n      title: 'Documentation',\n      url: '#',\n      icon: h(BookOpenIcon),\n      items: [\n        { title: 'Introduction', url: '#' },\n        { title: 'Get Started', url: '#' },\n        { title: 'Tutorials', url: '#' },\n        { title: 'Changelog', url: '#' },\n      ],\n    },\n    {\n      title: 'Settings',\n      url: '#',\n      icon: h(Settings2Icon),\n      items: [\n        { title: 'General', url: '#' },\n        { title: 'Team', url: '#' },\n        { title: 'Billing', url: '#' },\n        { title: 'Limits', url: '#' },\n      ],\n    },\n  ],\n\n  projects: [\n    {\n      name: 'Design Engineering',\n      url: '#',\n      icon: h(FrameIcon),\n    },\n    {\n      name: 'Sales & Marketing',\n      url: '#',\n      icon: h(PieChartIcon),\n    },\n    {\n      name: 'Travel',\n      url: '#',\n      icon: h(MapIcon),\n    },\n  ],\n}\n",
      "type": "registry:file",
      "target": "src/layouts/sidebar-07/data.ts"
    }
  ],
  "type": "registry:block"
}