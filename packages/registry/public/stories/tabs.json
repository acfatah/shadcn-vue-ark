{
  "name": "tabs",
  "type": "registry:stories",
  "files": [
    {
      "path": "_registry.ts",
      "content": "import { html } from 'common-tags'\n\nexport const registryItem = {\n  type: 'registry:ui',\n  name: 'tabs',\n  title: 'Tabs',\n\n  description: html`\n    A set of layered sections of content—known as tab panels—that are displayed\n    one at a time.\n\n    References:\n    - Headless API: https://ark-ui.com/docs/components/tabs\n    - shadcn/ui: https://ui.shadcn.com/docs/components/tabs\n  `,\n\n  dependencies: [\n    '@ark-ui/vue',\n    '@vueuse/core',\n    'class-variance-authority',\n  ],\n}\n\nexport default registryItem\n"
    },
    {
      "path": "Tabs.stories.ts",
      "content": "import type { Meta, StoryObj } from '@storybook/vue3-vite'\n\nimport { html } from 'common-tags'\n\nimport { Tabs } from '@/components/ui/tabs'\nimport { registryItem } from './_registry'\n\nimport TabsDefaultStory from './TabsDefaultStory.vue'\nimport TabsDefaultSource from './TabsDefaultStory.vue?raw'\nimport TabsUnderlineStory from './TabsUnderlineStory.vue'\nimport TabsUnderlineSource from './TabsUnderlineStory.vue?raw'\n\nconst meta = {\n  title: 'Components/UI/Tabs',\n  component: Tabs.Root,\n  tags: ['autodocs'],\n\n  parameters: {\n    docs: {\n      description: {\n        component: registryItem.description,\n      },\n    },\n  },\n} satisfies Meta<typeof Tabs.Root>\n\nexport default meta\ntype Story = StoryObj<typeof meta>\n\nexport const Default: Story = {\n  parameters: {\n    docs: {\n      source: {\n        code: TabsDefaultSource,\n      },\n    },\n  },\n\n  render: args => ({\n    components: { TabsDefaultStory },\n\n    setup() {\n      return { args }\n    },\n\n    template: html`\n      <TabsDefaultStory v-bind=\"args\" />\n    `,\n  }),\n}\n\nexport const Underline: Story = {\n  parameters: {\n    docs: {\n      source: {\n        code: TabsUnderlineSource,\n      },\n    },\n  },\n\n  render: args => ({\n    components: { TabsUnderlineStory },\n\n    setup() {\n      return { args }\n    },\n\n    template: html`\n      <TabsUnderlineStory v-bind=\"args\" />\n    `,\n  }),\n}\n"
    },
    {
      "path": "TabsDefaultStory.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card } from '@/components/ui/card'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport { Tabs } from '@/components/ui/tabs'\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-sm flex-col gap-6\">\n    <Tabs.Root default-value=\"account\">\n      <Tabs.List>\n        <Tabs.Trigger value=\"account\">\n          Account\n        </Tabs.Trigger>\n        <Tabs.Trigger value=\"password\">\n          Password\n        </Tabs.Trigger>\n      </Tabs.List>\n      <Tabs.Content value=\"account\">\n        <Card.Root>\n          <Card.Header>\n            <Card.Title>Account</Card.Title>\n            <Card.Description>\n              Make changes to your account here. Click save when you're\n              done.\n            </Card.Description>\n          </Card.Header>\n          <Card.Content class=\"grid gap-6\">\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-demo-name\">Name</Label>\n              <Input.Text id=\"tabs-demo-name\" default-value=\"Pedro Duarte\" />\n            </div>\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-demo-username\">Username</Label>\n              <Input.Text id=\"tabs-demo-username\" default-value=\"@peduarte\" />\n            </div>\n          </Card.Content>\n          <Card.Footer>\n            <Input.Button>Save changes</Input.Button>\n          </Card.Footer>\n        </Card.Root>\n      </Tabs.Content>\n      <Tabs.Content value=\"password\">\n        <Card.Root>\n          <Card.Header>\n            <Card.Title>Password</Card.Title>\n            <Card.Description>\n              Change your password here. After saving, you'll be logged\n              out.\n            </Card.Description>\n          </Card.Header>\n          <Card.Content class=\"grid gap-6\">\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-demo-current\">Current password</Label>\n              <Input.Password id=\"tabs-demo-current\" />\n            </div>\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-demo-new\">New password</Label>\n              <Input.Password id=\"tabs-demo-new\" />\n            </div>\n          </Card.Content>\n          <Card.Footer>\n            <Input.Button>Save password</Input.Button>\n          </Card.Footer>\n        </Card.Root>\n      </Tabs.Content>\n    </Tabs.Root>\n  </div>\n</template>\n"
    },
    {
      "path": "TabsUnderlineStory.vue",
      "content": "<script setup lang=\"ts\">\nimport { Card } from '@/components/ui/card'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport { Tabs } from '@/components/ui/tabs'\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-sm flex-col gap-6\">\n    <Tabs.Root default-value=\"account\" variant=\"underline\">\n      <Tabs.List>\n        <Tabs.Trigger value=\"account\">\n          Account\n        </Tabs.Trigger>\n        <Tabs.Trigger value=\"password\">\n          Password\n        </Tabs.Trigger>\n        <Tabs.Indicator />\n      </Tabs.List>\n      <Tabs.Content value=\"account\">\n        <Card.Root>\n          <Card.Header>\n            <Card.Title>Account</Card.Title>\n            <Card.Description>\n              Make changes to your account here. Click save when you're\n              done.\n            </Card.Description>\n          </Card.Header>\n          <Card.Content class=\"grid gap-6\">\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-underline-name\">Name</Label>\n              <Input.Text id=\"tabs-underline-name\" default-value=\"Pedro Duarte\" />\n            </div>\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-underline-username\">Username</Label>\n              <Input.Text id=\"tabs-underline-username\" default-value=\"@peduarte\" />\n            </div>\n          </Card.Content>\n          <Card.Footer>\n            <Input.Button>Save changes</Input.Button>\n          </Card.Footer>\n        </Card.Root>\n      </Tabs.Content>\n      <Tabs.Content value=\"password\">\n        <Card.Root>\n          <Card.Header>\n            <Card.Title>Password</Card.Title>\n            <Card.Description>\n              Change your password here. After saving, you'll be logged\n              out.\n            </Card.Description>\n          </Card.Header>\n          <Card.Content class=\"grid gap-6\">\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-underline-current\">Current password</Label>\n              <Input.Password id=\"tabs-underline-current\" />\n            </div>\n            <div class=\"grid gap-3\">\n              <Label for=\"tabs-underline-new\">New password</Label>\n              <Input.Password id=\"tabs-underline-new\" />\n            </div>\n          </Card.Content>\n          <Card.Footer>\n            <Input.Button>Save password</Input.Button>\n          </Card.Footer>\n        </Card.Root>\n      </Tabs.Content>\n    </Tabs.Root>\n  </div>\n</template>\n"
    }
  ]
}
