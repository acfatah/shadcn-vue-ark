{
  "name": "@acfatah/shadcn-vue-ark",
  "homepage": "https://github.com/acfatah/shadcn-vue-ark",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "bunx simple-git-hooks",
    "storybook": "cd packages/registry && bun storybook",
    "storybook:build": "cd packages/registry && bun storybook:build",
    "registry": "cd packages/registry && bun registry",
    "registry:build": "cd packages/registry && bun registry:build",
    "outdated:all": "bun scripts/outdated-all.ts",
    "update:all": "bun scripts/update-all.ts",
    "precommit": "cd packages/registry && bun lint:staged"
  },
  "devDependencies": {
    "@acfatah/eslint-preset": "^5.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "pathe": "^2.0.3",
    "simple-git-hooks": "^2.13.1"
  },
  "peerDependencies": {
    "typescript": "~6.0.3"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "simple-git-hooks"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "bun precommit",
    "commit-msg": "bun commitlint --edit ${1}"
  }
}
