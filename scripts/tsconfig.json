{
  // IDE-only config for the Bun scripts in this folder. Not part of the root
  // `tsc -b` graph and not run in CI; the editor's TS server resolves these
  // files through this nearest tsconfig. Ambient globals come from the root
  // `@types/bun` + `@types/node` dev deps.
  "compilerOptions": {
    // Environment & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",

    // Bun executes these files directly (no bundler, no emit)
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Pin ambient globals: setTimeout, Response, TextDecoder, NodeJS.*
    "types": [
      "bun",
      "node"
    ],

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Intentionally not enforced (scripts keep _-prefixed unused vars)
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },

  "include": [
    "./**/*.ts"
  ]
}
